{
  "description": "Foreman: show active plans and next ready tasks at session start; let the main agent change workbench/ without prompts and keep subagents out of it; let the main agent read the plugin's own files in any turn",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/workbench-guard.js\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
